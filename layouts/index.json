{{- $.Scratch.Add "index" slice -}}

{{- range $name, $taxonomy := .Site.Taxonomies.kategoriler -}}
    {{- $.Scratch.Add "index" (dict "url" (print "/kategoriler/" $name | absURL) "title" ($name | humanize) "iconClass" "fa-folder" "type" "category" "objectID" (print "/kategoriler/" $name | absURL) ) -}}
{{- end -}}

{{- range $name, $taxonomy := .Site.Taxonomies.yazar -}}
    {{- $.Scratch.Add "index" (dict "url" (print "/yazar/" $name | absURL) "title" ($name | humanize) "iconClass" "fa-user" "type" "author" "objectID" (print "/yazar/" $name | absURL) ) -}}
{{- end -}}

{{- range $name, $taxonomy := .Site.Taxonomies.etiketler -}}
    {{- $.Scratch.Add "index" (dict "url" (print "/etiketler/" $name | absURL) "title" ($name | humanize) "iconClass" "fa-tag" "type" "tag" "objectID" (print "/etiketler/" $name | absURL) ) -}}
{{- end -}}

{{- range where .Site.RegularPages "Type" "not in" (slice "page" "json") -}}
    {{-  $iconClass := "fa-pencil-alt" -}}
    {{- if eq .Type "quote" -}}
        {{- $iconClass = "fa-quote-right" -}}
    {{- else if eq .Type "link" -}}
        {{- $iconClass = "fa-link" -}}
    {{- else if eq .Type "video" -}}
        {{- $iconClass = "fa-video" -}}
    {{- else if or (eq .Type "gallery") (eq .Type "picture") -}}
        {{- $iconClass = "fa-camera" -}}
    {{- else if eq .Type "audio" -}}
        {{- $iconClass = "fa-music" -}}
    {{- else if eq .Type "code" -}}
        {{- $iconClass = "fa-code" -}}
    {{- end -}}

    {{- range .Translations -}}
        {{- $.Scratch.Add "index" (dict "url" .Permalink "title" .Title "etiketler" .Params.etiketler "kategoriler" .Params.kategoriler "yazar" .Params.yazar "type" .Type "language" .Lang "iconClass" $iconClass "objectID" (.Permalink | md5) ) -}}
    {{- end -}}
    {{- $.Scratch.Add "index" (dict "url" .Permalink "title" .Title "etiketler" .Params.etiketler "kategoriler" .Params.kategoriler "yazar" .Params.yazar "type" .Type "language" .Lang "iconClass" $iconClass "objectID" (.Permalink | md5) ) -}}

{{- end -}}

{{- $.Scratch.Get "index" | jsonify -}}
