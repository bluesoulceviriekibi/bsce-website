{{- $.Scratch.Add "index" slice -}}

{{- range $name, $taxonomy := .Site.Taxonomies.ceviriler -}}
    {{- $.Scratch.Add "index" (dict "url" (print "/ceviriler/" $name | absURL) "title" ($name | humanize) "iconClass" "fa-folder" "type" "ceviri" "objectID" (print "/ceviriler/" $name | absURL) ) -}}
{{- end -}}

{{- range $name, $taxonomy := .Site.Taxonomies.yazar -}}
    {{- $.Scratch.Add "index" (dict "url" (print "/yazar/" $name | absURL) "title" ($name | humanize) "iconClass" "fa-user" "type" "yazar" "objectID" (print "/yazar/" $name | absURL) ) -}}
{{- end -}}

{{- range $name, $taxonomy := .Site.Taxonomies.etiketler -}}
    {{- $.Scratch.Add "index" (dict "url" (print "/etiketler/" $name | absURL) "title" ($name | humanize) "iconClass" "fa-tag" "type" "etiket" "objectID" (print "/etiketler/" $name | absURL) ) -}}
{{- end -}}

{{- range where .Site.RegularPages "Type" "not in" (slice "sayfa" "json") -}}
    {{-  $iconClass := "fa-pencil-alt" -}}
    {{- if eq .Type "alinti" -}}
        {{- $iconClass = "fa-quote-right" -}}
    {{- else if eq .Type "link" -}}
        {{- $iconClass = "fa-link" -}}
    {{- else if eq .Type "video" -}}
        {{- $iconClass = "fa-video" -}}
    {{- else if eq .Type "oyun" -}}
        {{- $iconClass = "fa-gamepad" -}}
    {{- else if or (eq .Type "galeri") (eq .Type "resim") -}}
        {{- $iconClass = "fa-camera" -}}
    {{- else if eq .Type "ses" -}}
        {{- $iconClass = "fa-music" -}}
    {{- else if eq .Type "kod" -}}
        {{- $iconClass = "fa-code" -}}
    {{- end -}}

    {{- range .Translations -}}
        {{- $.Scratch.Add "index" (dict "url" .Permalink "title" .Title "etiketler" .Params.etiketler "ceviriler" .Params.ceviriler "yazar" .Params.yazar "type" .Type "language" .Lang "iconClass" $iconClass "objectID" (.Permalink | md5) ) -}}
    {{- end -}}
    {{- $.Scratch.Add "index" (dict "url" .Permalink "title" .Title "etiketler" .Params.etiketler "ceviriler" .Params.ceviriler "yazar" .Params.yazar "type" .Type "language" .Lang "iconClass" $iconClass "objectID" (.Permalink | md5) ) -}}

{{- end -}}

{{- $.Scratch.Get "index" | jsonify -}}
