{{- $.Scratch.Add "index" slice -}}

{{- range $name, $taxonomy := .Site.Taxonomies.etiketler -}}
    {{- $.Scratch.Add "index" (dict "url" (print "/etiketler/" $name | absURL) "title" ($name | humanize) "iconClass" "fa-tag" "type" "etiket" "objectID" (print "/etiketler/" $name | absURL) ) -}}
{{- end -}}

{{- range where (where .Site.RegularPages "Type" "not in" (slice "sayfa" "json")) "Type" "not in" (slice "indir" "json") -}}
    {{-  $iconClass := "fa-file" -}}

    {{- if eq .Type "oyun" -}}
        {{- $iconClass = "fa-gamepad" -}}
    {{- else if eq .Type "video" -}}
        {{- $iconClass = "fa-video" -}}
    {{- else if eq .Type "anime" -}}
        {{- $iconClass = "fa-video" -}}
    {{- else if eq .Type "yazi" -}}
        {{- $iconClass = "fa-pen" -}}
    {{- end -}}

    {{- range .Translations -}}
        {{- $.Scratch.Add "index" (dict "url" .Permalink "title" .Title "etiketler" .Params.etiketler "ceviriler" .Params.ceviriler "yazar" .Params.yazar "type" .Type "language" .Lang "iconClass" $iconClass "objectID" (.Permalink | md5) ) -}}
    {{- end -}}
    {{- $.Scratch.Add "index" (dict "url" .Permalink "title" .Title "etiketler" .Params.etiketler "ceviriler" .Params.ceviriler "yazar" .Params.yazar "type" .Type "language" .Lang "iconClass" $iconClass "objectID" (.Permalink | md5) ) -}}

{{- end -}}

{{- $.Scratch.Get "index" | jsonify -}}
